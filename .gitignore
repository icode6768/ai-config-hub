# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
/webui-apps/
node_modules.windows-backup-*/
node_modules
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Runtime files — 逐项忽略二进制/数据目录,scripts 子目录不在列表中即默认跟踪
runtime/windows/bin
runtime/windows/node
runtime/windows/npm-global
runtime/windows/python
runtime/windows/temp
runtime/macos/bin
runtime/macos/node
runtime/macos/npm-global
runtime/macos/python
runtime/macos/temp
runtime/macos/homebrew
runtime/macos/nvm
runtime/macos/pyenv

docs

# .dsh 目录:整体忽略,但保留 settings.yaml 与 deepseek-harness(及其子文件)
.dsh/*
!.dsh/settings.yaml
!.dsh/launch-deepseek-harness-macos.command
!.dsh/launch-deepseek-harness-windows.bat
!.dsh/deepseek-harness
!.dsh/deepseek-harness/**

# .openclaw 目录:整体忽略,但保留 state/openclaw.json 与 skills(及其子文件)
.openclaw/*
!.openclaw/state/openclaw.json
!.openclaw/skills
!.openclaw/skills/**

# .codex 目录:整体忽略,但保留 config.toml 与 skills(及其子文件)
.codex/*
!.codex/config.toml
!.codex/skills
!.codex/skills/**

# .claude 目录:整体忽略,但保留 settings.json 与 skills(及其子文件)
.claude/*
!.claude/settings.json
!.claude/skills
!.claude/skills/**

# .hermes 目录:整体忽略,但保留 config.yaml 与 skills(及其子文件)
.hermes/*
!.hermes/config.yaml
!.hermes/skills
!.hermes/skills/**
!.hermes/hermes-agent
!.hermes/hermes-agent/**

# myproxy-capture skill 中的敏感文件(曾在 commit 783283a 入仓,已用 git filter-repo 清理)
# 任何 .<agent>/skills/myproxy-capture/scripts/ 下的 system.conf / *.pem / test_output / *.db 都视作敏感
**/myproxy-capture/scripts/system.conf
**/myproxy-capture/scripts/key.pem
**/myproxy-capture/scripts/*.pem
**/myproxy-capture/scripts/*_test_output.txt
**/myproxy-capture/scripts/*.db
**/myproxy-capture/scripts/*.sqlite*

# Hermes runtime 会在 .hermes/hermes-agent/contributors/emails/ 注入本机用户名
# (形如 agent@<Hostname>.local、agent@openclaw.local),只是本地运行时标记,不入版本控制
.hermes/hermes-agent/contributors/emails/*@*.local
.hermes/hermes-agent/contributors/emails/agent@*.local
